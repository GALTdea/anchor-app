<% processing_status = @results_presenter.processing_status %>
<% updated_at = @results_presenter.child_snapshot_updated_at %>
<% insight_cards = @results_presenter.support_guide_insights %>
<% hard_moment_cards = @results_presenter.hard_moment_guide_cards %>
<% planning_areas = @results_presenter.planning_focus_areas %>
<% support_style_lines = @results_presenter.best_support_style_lines %>
<% focus_priorities = @results_presenter.support_priorities %>
<% weekly_ideas = @results_presenter.weekly_ideas %>
<% learning_areas = @results_presenter.learning_areas %>
<div class="mx-auto max-w-6xl space-y-6">
  <%= render "shared/page_header",
    title: @results_presenter.page_title,
    subtitle: @results_presenter.page_subtitle %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Recommendations",
      space_child_profile_recommendations_path(@space, @child_profile),
      class: "btn btn-outline btn-sm" %>
    <%= link_to "Assessments",
      space_child_profile_assessments_path(@space, @child_profile),
      class: "btn btn-outline btn-sm" %>
    <% if policy(@child_profile).update? %>
      <%= link_to "Edit child details",
        edit_space_child_profile_path(@space, @child_profile),
        class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-primary badge-outline"><%= @results_presenter.profile_state_label %></span>
        <% if processing_status.present? %>
          <span class="<%= assessment_processing_badge_class(processing_status) %>">
            <%= assessment_processing_status_label(processing_status) %>
          </span>
        <% end %>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-base-content">Child Snapshot</h2>
        <dl class="mt-4 grid gap-4 text-sm md:grid-cols-4">
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <dt class="text-base-content/60">Name</dt>
            <dd class="mt-1 font-medium text-base-content"><%= @child_profile.name %></dd>
          </div>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <dt class="text-base-content/60">Age</dt>
            <dd class="mt-1 font-medium text-base-content">
              <%= @child_profile.date_of_birth.present? ? "#{@child_profile.age} years" : "Not added yet" %>
            </dd>
          </div>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <dt class="text-base-content/60">Last updated</dt>
            <dd class="mt-1 font-medium text-base-content"><%= l(updated_at.to_date, format: :long) %></dd>
          </div>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <dt class="text-base-content/60">Freshness</dt>
            <dd class="mt-1 font-medium text-base-content">
              <% if updated_at.to_date == Date.current %>
                Updated today
              <% else %>
                Updated <%= time_ago_in_words(updated_at) %> ago
              <% end %>
            </dd>
          </div>
        </dl>
      </div>

      <% if @latest_assessment_response.present? %>
        <p class="rounded-box bg-base-200/70 p-4 text-sm leading-6 text-base-content/70">
          <%= @results_presenter.snapshot_provenance_phrase %>
        </p>
      <% elsif policy(Assessment.new(child_profile: @child_profile)).create? %>
        <div class="rounded-box border border-primary/30 bg-primary/10 p-5">
          <h3 class="text-base font-semibold text-base-content">Start with the onboarding assessment</h3>
          <p class="mt-2 text-sm leading-6 text-base-content/75">
            Answer a few guided questions so Anchor can build a clearer first profile for <%= @child_profile.first_name %>.
          </p>
          <div class="mt-4">
            <%= link_to "Start onboarding assessment",
              new_space_child_profile_assessment_path(@space, @child_profile),
              class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold text-base-content">What Anchor Understands Right Now</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Short insight cards based on what has been shared so far—always a working picture, not a final word.
        </p>
      </div>

      <% if (context_note = @results_presenter.support_guide_context_note).present? %>
        <p class="text-sm leading-6 text-base-content/65">
          <%= context_note %>
        </p>
      <% end %>

      <div class="grid gap-3 md:grid-cols-2">
        <% insight_cards.each do |card| %>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <p class="text-sm leading-6 text-base-content/75"><%= card.body %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold text-base-content">When Things Get Hard</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Gentle guesses to help you prepare—not fixed triggers Anchor knows for certain.
        </p>
      </div>

      <div class="grid gap-3 md:grid-cols-3">
        <% hard_moment_cards.each do |card| %>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <h3 class="text-sm font-semibold text-base-content"><%= card.title %></h3>
            <p class="mt-3 text-sm leading-6 text-base-content/75"><%= card.body %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold text-base-content">What to Plan Around</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Prevention-minded reminders you can keep in your back pocket.
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        <% planning_areas.each do |area| %>
          <span class="badge badge-outline badge-lg font-normal"><%= area.label %></span>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold text-base-content">Best Support Style</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Strengths and context you already named—so this page feels personal, not like a deficit list.
        </p>
      </div>

      <dl class="space-y-4">
        <% support_style_lines.each do |line| %>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50"><%= line.label %></dt>
            <dd class="mt-2 text-sm leading-6 text-base-content/80"><%= line.detail %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold text-base-content">Focus Right Now</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Choose one focus at a time—steady beats sprawling.
        </p>
      </div>

      <div class="grid gap-3 md:grid-cols-3">
        <% focus_priorities.each do |priority| %>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <h3 class="text-sm font-semibold text-base-content"><%= priority.focus %></h3>
            <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-base-content/50">Why it matters</p>
            <p class="mt-1 text-sm leading-6 text-base-content/75"><%= priority.why_it_matters %></p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-base-content/50">What to try first</p>
            <p class="mt-1 text-sm leading-6 text-base-content/75"><%= priority.what_to_try_first %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold text-base-content">Try This This Week</h2>
          <p class="mt-1 text-sm leading-6 text-base-content/70">
            Small experiments—pick one, notice what shifts, keep what helps.
          </p>
        </div>
        <%= link_to "View all recommendations",
          space_child_profile_recommendations_path(@space, @child_profile),
          class: "btn btn-ghost btn-sm" %>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        <% weekly_ideas.each do |idea| %>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-base font-semibold text-base-content"><%= idea.title %></h3>
              <span class="badge badge-primary badge-outline"><%= idea.estimated_time %></span>
            </div>
            <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-base-content/50">Why it may help</p>
            <p class="mt-1 text-sm leading-6 text-base-content/75"><%= idea.why_it_may_help %></p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-base-content/50">How to try it</p>
            <p class="mt-1 text-sm leading-6 text-base-content/75"><%= idea.how_to_try_it %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div>
        <h2 class="text-lg font-semibold text-base-content">What We're Still Learning</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Gentle noticing—not homework or pressure to collect data.
        </p>
      </div>

      <div class="grid gap-3 md:grid-cols-2">
        <% learning_areas.each do |area| %>
          <div class="rounded-box border border-base-300/70 bg-base-100 p-4 text-sm leading-6 text-base-content/75">
            <%= area.body %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Back to profiles", space_child_profiles_path(@space), class: "btn btn-ghost btn-sm" %>
      <%= link_to "Full profile details",
        space_child_profile_current_profile_path(@space, @child_profile),
        class: "link link-hover text-sm text-base-content/60" %>
    </div>
    <% if policy(@child_profile).destroy? && @child_profile.active? %>
      <%= button_to "Archive profile", space_child_profile_path(@space, @child_profile),
        method: :delete,
        form: { data: { turbo_confirm: "Archive #{@child_profile.name}? This can be undone later." } },
        class: "btn btn-error btn-sm" %>
    <% end %>
  </div>
</div>
