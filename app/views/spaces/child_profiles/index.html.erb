<div class="max-w-6xl mx-auto">
  <%= render "shared/page_header",
    title: "Child Profiles",
    subtitle: "Manage children in #{@space.name}" %>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex justify-between items-center mb-4">
        <h3 class="card-title">Active Profiles</h3>
        <% if policy(@space).create? %>
          <%= link_to new_space_child_profile_path(@space), class: "btn btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Add Child Profile
          <% end %>
        <% end %>
      </div>

      <% if @child_profiles.any? %>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Date of Birth</th>
                <th>Created</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @child_profiles.each do |profile| %>
                <tr>
                  <td>
                    <%= link_to space_child_profile_path(@space, profile), class: "link link-primary" do %>
                      <%= profile.name %>
                    <% end %>
                  </td>
                  <td><%= profile.age %> years</td>
                  <td><%= profile.date_of_birth.strftime("%b %d, %Y") %></td>
                  <td><%= profile.created_at.strftime("%b %d, %Y") %></td>
                  <td class="text-right">
                    <div class="join">
                      <% if policy(profile).update? %>
                        <%= link_to "Edit", edit_space_child_profile_path(@space, profile), class: "btn btn-sm join-item" %>
                      <% end %>
                      <% if policy(profile).destroy? %>
                        <%= button_to "Archive", space_child_profile_path(@space, profile),
                          method: :delete,
                          form: { data: { turbo_confirm: "Archive #{profile.name}? This can be undone later." } },
                          class: "btn btn-sm btn-ghost join-item" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-base-content/60 mb-4">No child profiles yet.</p>
          <% if policy(@space).create? %>
            <%= link_to "Add your first child profile", new_space_child_profile_path(@space), class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
