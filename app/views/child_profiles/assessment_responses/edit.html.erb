<% template = @assessment.assessment_template %>
<% answers = (@assessment_response.answers || {}).stringify_keys %>
<% sections = assessment_sections(template) %>
<% progress = assessment_progress(template, answers) %>

<div class="mx-auto max-w-5xl space-y-6">
  <%= render "shared/page_header",
    title: template.title,
    subtitle: "Onboarding draft · #{@child_profile.name}" %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.7fr)_20rem]">
    <div class="space-y-6">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-primary badge-outline">Onboarding assessment</span>
            <span class="badge badge-ghost">Template v<%= @assessment_response.template_version_snapshot %></span>
          </div>
          <div class="space-y-2">
            <h2 class="text-2xl font-semibold text-base-content">
              <%= assessment_intro_title(template) %>
            </h2>
            <p class="max-w-3xl text-base leading-7 text-base-content/75">
              <%= assessment_intro_body(template) %>
            </p>
          </div>
          <div class="rounded-box bg-base-200/70 p-4">
            <p class="text-sm leading-6 text-base-content/75">
              You can save at any time and come back later. The goal is to create a clear starting picture of how <%= @child_profile.name %> experiences the world today.
            </p>
          </div>
        </div>
      </div>

      <%= form_with model: @assessment_response,
        url: space_child_profile_assessment_assessment_response_path(@space, @child_profile, @assessment),
        method: :patch,
        class: "space-y-6" do |f| %>
        <% if @assessment_response.errors.any? %>
          <div class="alert alert-error">
            <ul class="list-disc list-inside">
              <% @assessment_response.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="space-y-1">
                <h3 class="text-lg font-semibold text-base-content">Who is answering today?</h3>
                <p class="text-sm text-base-content/70">
                  This helps the app interpret the answers with the right context.
                </p>
              </div>
              <div class="min-w-64 flex-1 lg:max-w-sm">
                <fieldset class="fieldset">
                  <label class="label" for="assessment_response_respondent_kind">Respondent</label>
                  <%= f.select :respondent_kind,
                    Array(template.respondent_types).map { |kind| [respondent_kind_label(kind), kind] },
                    {},
                    class: "select w-full",
                    id: "assessment_response_respondent_kind" %>
                </fieldset>
              </div>
            </div>
          </div>
        </div>

        <% sections.each_with_index do |section, index| %>
          <% section_progress = assessment_section_progress(section, answers) %>
          <section id="<%= section["id"] %>" class="card bg-base-100 shadow-sm">
            <div class="card-body gap-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="badge badge-ghost">Section <%= index + 1 %> of <%= sections.size %></span>
                    <span class="badge badge-outline">
                      <%= section_progress[:answered] %>/<%= section_progress[:total] %> answered
                    </span>
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold text-base-content"><%= section["title"] %></h3>
                    <% if section["description"].present? %>
                      <p class="mt-1 text-sm leading-6 text-base-content/70"><%= section["description"] %></p>
                    <% end %>
                  </div>
                </div>
              </div>

              <div class="space-y-4">
                <% Array(section["questions"]).each do |question| %>
                  <%= render "question_field", question: question, answers: answers %>
                <% end %>
              </div>
            </div>
          </section>
        <% end %>

        <div class="flex flex-wrap gap-2">
          <%= button_tag "Save draft", type: "submit", name: "submit_action", value: "draft", class: "btn btn-ghost" %>
          <%= button_tag "Submit onboarding assessment", type: "submit", name: "submit_action", value: "submit", class: "btn btn-primary" %>
          <%= link_to "Cancel", space_child_profile_assessment_path(@space, @child_profile, @assessment), class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div>
            <p class="text-sm font-medium text-base-content/60">Progress</p>
            <h3 class="mt-1 text-2xl font-semibold text-base-content">
              <%= progress[:answered] %> of <%= progress[:total] %> answered
            </h3>
          </div>
          <progress class="progress progress-primary w-full" value="<%= progress[:percentage] %>" max="100"></progress>
          <p class="text-sm text-base-content/70">
            <%= progress[:percentage] %>% complete
          </p>
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h3 class="text-base font-semibold text-base-content">What to expect</h3>
          <ul class="space-y-2 text-sm leading-6 text-base-content/70">
            <li>Answer only what feels true today.</li>
            <li>You can save your progress and come back later.</li>
            <li>After submission, the app will use this as the starting point for your child’s profile.</li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h3 class="text-base font-semibold text-base-content">Sections</h3>
          <nav class="space-y-2">
            <% sections.each_with_index do |section, index| %>
              <%= link_to "##{section["id"]}", class: "flex items-center justify-between rounded-box border border-base-300/70 px-3 py-2 text-sm text-base-content hover:bg-base-200/70" do %>
                <span><%= index + 1 %>. <%= section["title"] %></span>
                <% section_progress = assessment_section_progress(section, answers) %>
                <span class="text-base-content/60"><%= section_progress[:answered] %>/<%= section_progress[:total] %></span>
              <% end %>
            <% end %>
          </nav>
        </div>
      </div>
    </aside>
  </div>
</div>
