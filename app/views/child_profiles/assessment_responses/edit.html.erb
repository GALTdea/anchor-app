<div class="mx-auto max-w-2xl space-y-6">
  <% if @assessment_response.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside">
        <% @assessment_response.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= turbo_frame_tag "assessment_runner_step" do %>
    <%= form_with model: @assessment_response,
      url: space_child_profile_assessment_assessment_response_path(@space, @child_profile, @assessment),
      method: :patch,
      class: "space-y-4",
      data: {
        controller: "assessment-autosave",
        assessment_autosave_delay_value: 600,
        action: "turbo:submit-start->assessment-autosave#submitting turbo:submit-end->assessment-autosave#submitted"
      } do |f| %>
      <%= f.hidden_field :respondent_kind, value: @assessment_response.respondent_kind %>
      <%= hidden_field_tag :current_step_id, @current_step["id"] %>
      <%= button_tag "Autosave", type: "submit", name: "submit_action", value: "stay", class: "hidden", data: { assessment_autosave_target: "submitter" } %>

      <section class="card overflow-hidden border border-base-200 bg-base-100 shadow-sm">
        <% visual_progress = @progress[:percentage].zero? ? 2 : @progress[:percentage] %>
        <div class="h-1.5 w-full bg-base-200" role="progressbar" aria-valuenow="<%= @progress[:percentage] %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= @progress[:percentage] %>% complete">
          <div class="h-full bg-primary transition" style="width: <%= visual_progress %>%"></div>
        </div>
        <div class="card-body gap-6">
          <div class="flex flex-wrap items-start justify-between gap-3 border-b border-base-200 pb-4">
            <div class="min-w-0">
              <p class="text-sm font-semibold leading-6 text-base-content">
                <%= @child_profile.name %>'s Profile <span class="text-base-content/40">&middot;</span> <%= @template.title %>
              </p>
              <p class="text-sm text-base-content/60"><%= @current_step["section_title"] %></p>
            </div>
            <p class="shrink-0 text-sm font-medium text-base-content/60">
              <%= @progress[:answered] %> of <%= @progress[:total] %> answered
            </p>
          </div>

          <% if @current_step["position"] == 1 && @current_step["section_description"].present? %>
            <div class="space-y-2">
              <h1 class="text-2xl font-semibold text-base-content"><%= @current_step["section_title"] %></h1>
              <p class="text-base leading-7 text-base-content/75"><%= @current_step["section_description"] %></p>
            </div>
          <% end %>

          <div class="space-y-4 pt-2">
            <% @current_step["questions"].each do |question| %>
              <%= render "question_field", question: question, answers: @answers, question_errors: @question_errors %>
            <% end %>
          </div>

          <div class="assessment-nav">
            <% if @previous_step.present? %>
              <%= button_tag "Back", type: "submit", name: "submit_action", value: "back", class: "assessment-back-button" %>
            <% end %>
            <% if @next_step.present? %>
              <%= button_tag "Continue", type: "submit", name: "submit_action", value: "next", class: "btn btn-primary" %>
            <% else %>
              <%= button_tag "Submit onboarding assessment",
                type: "submit",
                name: "submit_action",
                value: "submit",
                class: "btn btn-primary",
                data: { turbo_frame: "_top" } %>
            <% end %>
            <p class="assessment-save-status <%= 'is-visible' if @save_status.present? %>" aria-live="polite" data-assessment-autosave-target="status"><%= @save_status %></p>
          </div>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
