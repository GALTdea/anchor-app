<div class="mx-auto max-w-2xl space-y-6">
  <div class="space-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/50">
      <%= @template.title %>
    </p>
    <div class="flex flex-wrap items-center justify-between gap-2 text-sm text-base-content/60">
      <span><%= @child_profile.name %></span>
      <span><%= @progress[:answered] %> of <%= @progress[:total] %> answered</span>
    </div>
  </div>

  <% if @assessment_response.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside">
        <% @assessment_response.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= turbo_frame_tag "assessment_runner_step" do %>
    <%= form_with model: @assessment_response,
      url: space_child_profile_assessment_assessment_response_path(@space, @child_profile, @assessment),
      method: :patch,
      class: "space-y-4",
      data: {
        controller: "assessment-autosave",
        assessment_autosave_delay_value: 600,
        action: "turbo:submit-start->assessment-autosave#submitting turbo:submit-end->assessment-autosave#submitted"
      } do |f| %>
      <%= f.hidden_field :respondent_kind, value: @assessment_response.respondent_kind %>
      <%= hidden_field_tag :current_step_id, @current_step["id"] %>
      <%= button_tag "Autosave", type: "submit", name: "submit_action", value: "stay", class: "hidden", data: { assessment_autosave_target: "submitter" } %>

      <section class="card bg-base-100 shadow-sm">
        <div class="card-body gap-6">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm text-base-content/60">
            <span>Section <%= @current_step["section_position"] %> of <%= @runner.sections.size %></span>
            <span>Step <%= @current_step["position"] %> of <%= @runner.steps.count { |step| step["section_id"] == @current_step["section_id"] } %></span>
          </div>

          <% if @current_step["position"] == 1 %>
            <div class="space-y-2">
              <h1 class="text-2xl font-semibold text-base-content"><%= @current_step["section_title"] %></h1>
              <% if @current_step["section_description"].present? %>
                <p class="text-base leading-7 text-base-content/75"><%= @current_step["section_description"] %></p>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm font-medium text-base-content/65"><%= @current_step["section_title"] %></p>
          <% end %>

          <div class="space-y-4">
            <% @current_step["questions"].each do |question| %>
              <%= render "question_field", question: question, answers: @answers %>
            <% end %>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <% if @previous_step.present? %>
              <%= button_tag "Back", type: "submit", name: "submit_action", value: "back", class: "btn btn-ghost" %>
            <% end %>
            <% if @next_step.present? %>
              <%= button_tag "Continue", type: "submit", name: "submit_action", value: "next", class: "btn btn-primary" %>
            <% else %>
              <%= button_tag "Submit onboarding assessment", type: "submit", name: "submit_action", value: "submit", class: "btn btn-primary" %>
            <% end %>
            <p class="text-sm text-base-content/60" data-assessment-autosave-target="status">Saved</p>
          </div>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
