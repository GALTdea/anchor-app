<% presenter = local_assigns[:presenter] %>
<% if presenter.is_a?(ChildProfileResultsPresenter) %>
  <% ai_panel = presenter.ai_guidance_panel %>
  <% show_deterministic = presenter.show_analysis_insights? %>
  <% if ai_panel.present? || show_deterministic %>
    <section class="card bg-base-100 shadow-sm" id="analysis-insights">
      <div class="card-body gap-5">
        <% if ai_panel.present? %>
          <section class="space-y-3 rounded-xl border border-primary/25 bg-base-200/40 p-4" id="ai-synthesis-guidance">
            <div>
              <h2 class="text-lg font-semibold text-base-content">Plain-language summary</h2>
              <p class="mt-1 text-sm leading-6 text-base-content/70">
                This short summary is drafted from Anchor's deterministic profile signals.
                It is supportive guidance (“this may mean…”), not a diagnosis or standalone authority.
                The numbered findings below still come straight from Anchor's analysis engine when available.
              </p>
            </div>
            <p class="text-base leading-7 text-base-content/85"><%= ai_panel.summary_plain %></p>
            <% if ai_panel.confidence_note.present? %>
              <p class="text-sm text-base-content/70"><%= ai_panel.confidence_note %></p>
            <% end %>
            <% if ai_panel.what_to_watch.any? %>
              <div>
                <h3 class="text-sm font-semibold text-base-content">What to keep watching</h3>
                <ul class="mt-2 list-disc space-y-1 pl-6 text-sm text-base-content/80">
                  <% ai_panel.what_to_watch.each do |line| %>
                    <li><%= line %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if show_deterministic %>
          <% if ai_panel.present? %>
            <hr class="border-base-300/70" />
          <% end %>
          <div>
            <h2 class="text-lg font-semibold text-base-content">What Anchor is noticing</h2>
            <p class="mt-1 text-sm leading-6 text-base-content/70">
              These are support signals from your answers and profile — working patterns to explore, not a diagnosis. When confidence is lower, it means Anchor is less certain, not that something is less important.
            </p>
          </div>

          <div class="space-y-4">
            <% presenter.parent_analysis_rows.each do |row| %>
              <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <h3 class="text-base font-semibold text-base-content"><%= row.title %></h3>
                  <% if row.low_confidence %>
                    <span class="badge badge-ghost">Lower confidence</span>
                  <% end %>
                </div>
                <p class="mt-2 text-sm leading-6 text-base-content/80"><%= row.summary %></p>
                <p class="mt-3 text-sm text-base-content/70"><%= row.confidence_phrase %></p>
                <p class="mt-1 text-sm text-base-content/60"><%= row.evidence_note %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
