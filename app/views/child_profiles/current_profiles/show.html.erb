<% dimensions = @current_profile.summary.fetch("dimensions", {}) %>
<% stats = @current_profile.summary.fetch("stats", {}) %>

<div class="mx-auto max-w-5xl space-y-6">
  <%= render "shared/page_header",
    title: "#{@child_profile.name}'s current profile",
    subtitle: "Living snapshot built from assessments and future evidence" %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_20rem]">
    <div class="space-y-6">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-primary badge-outline">Current profile</span>
            <span class="badge badge-ghost">Version <%= @current_profile.profile_version %></span>
          </div>
          <p class="text-base leading-7 text-base-content/80">
            <%= @current_profile.narrative.presence || "Not enough evidence yet to generate a narrative profile." %>
          </p>
        </div>
      </div>

      <%= render "child_profiles/shared/analysis_insights", presenter: @results_presenter %>

      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-5">
          <div>
            <h3 class="text-lg font-semibold text-base-content">Tracked dimensions</h3>
            <p class="mt-1 text-sm text-base-content/70">
              These are the latest profile signals currently shaping the child portrait.
            </p>
          </div>

          <% if dimensions.present? %>
            <div class="space-y-4">
              <% dimensions.sort.each do |dimension_key, details| %>
                <div class="rounded-box border border-base-300/70 bg-base-100 p-4">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h4 class="text-base font-semibold text-base-content"><%= dimension_key.to_s.tr(".", " ").humanize %></h4>
                      <p class="mt-1 text-sm text-base-content/70">
                        Latest value: <span class="font-medium text-base-content"><%= details["metadata"].to_h["selected_option_label"].presence || details["latest_value"] %></span>
                      </p>
                    </div>
                    <span class="badge badge-outline"><%= details["evidence_count"] %> evidence</span>
                  </div>
                  <dl class="mt-4 grid gap-3 text-sm md:grid-cols-3">
                    <div>
                      <dt class="text-base-content/60">Confidence</dt>
                      <dd><%= number_to_percentage(details["confidence"].to_f * 100, precision: 0) %></dd>
                    </div>
                    <div>
                      <dt class="text-base-content/60">Respondent</dt>
                      <dd><%= respondent_kind_label(details["respondent_kind"]) %></dd>
                    </div>
                    <div>
                      <dt class="text-base-content/60">Recorded</dt>
                      <dd><%= details["recorded_at"].present? ? l(Time.zone.parse(details["recorded_at"]), format: :long) : "—" %></dd>
                    </div>
                  </dl>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-box border border-dashed border-base-300 p-6 text-sm text-base-content/70">
              The current profile will appear here after onboarding evidence is processed.
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h3 class="text-base font-semibold text-base-content">Profile stats</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-base-content/60">Evidence points</dt>
              <dd><%= stats["evidence_count"] || 0 %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-base-content/60">Dimensions</dt>
              <dd><%= stats["dimension_count"] || 0 %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-base-content/60">Generated</dt>
              <dd><%= @current_profile.generated_at.present? ? l(@current_profile.generated_at, format: :long) : "—" %></dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h3 class="text-base font-semibold text-base-content">Next</h3>
          <p class="text-sm leading-6 text-base-content/70">
            Recommendations are generated from the latest profile snapshot and will get sharper as more evidence arrives.
          </p>
          <%= link_to "View recommendations",
            space_child_profile_recommendations_path(@space, @child_profile),
            class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </aside>
  </div>
</div>
