<div class="mx-auto max-w-4xl space-y-6">
  <%= render "shared/page_header",
    title: @recommendation.title,
    subtitle: "#{@child_profile.name} · #{@recommendation.category.humanize}" %>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-primary badge-outline"><%= @recommendation.category.humanize %></span>
        <span class="badge badge-ghost"><%= l(@recommendation.generated_at, format: :long) %></span>
      </div>

      <p class="text-base leading-7 text-base-content/80"><%= @recommendation.body %></p>

      <div class="rounded-box bg-base-200/60 p-4">
        <h3 class="text-base font-semibold text-base-content">Why this was suggested</h3>
        <dl class="mt-3 grid gap-3 text-sm md:grid-cols-2">
          <div>
            <dt class="text-base-content/60">Dimension</dt>
            <dd><%= @recommendation.rationale["dimension_key"].to_s.tr(".", " ").humanize %></dd>
          </div>
          <div>
            <dt class="text-base-content/60">Current signal</dt>
            <dd><%= @recommendation.rationale["display_value"] || @recommendation.rationale["latest_value"] %></dd>
          </div>
          <div>
            <dt class="text-base-content/60">Confidence</dt>
            <dd><%= number_to_percentage(@recommendation.rationale["confidence"].to_f * 100, precision: 0) %></dd>
          </div>
          <div>
            <dt class="text-base-content/60">Respondent</dt>
            <dd><%= respondent_kind_label(@recommendation.rationale["respondent_kind"]) %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Back to recommendations",
      space_child_profile_recommendations_path(@space, @child_profile),
      class: "btn btn-ghost" %>
    <%= link_to "View current profile",
      space_child_profile_current_profile_path(@space, @child_profile),
      class: "btn btn-primary" %>
  </div>
</div>
