<div class="max-w-4xl mx-auto">
  <%= render "shared/page_header",
    title: @assessment.assessment_template.title,
    subtitle: "#{@child_profile.name} · #{@assessment.status.capitalize}" %>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body space-y-4">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <dt class="text-sm font-medium text-base-content/60">Template</dt>
          <dd><%= @assessment.assessment_template.title %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-base-content/60">Status</dt>
          <dd>
            <span class="badge <%= @assessment.submitted? ? 'badge-success' : (@assessment.draft? ? 'badge-warning' : 'badge-ghost') %>">
              <%= @assessment.status.capitalize %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-base-content/60">Last updated</dt>
          <dd><%= l(@assessment.updated_at, format: :long) %></dd>
        </div>
      </dl>

      <% response = @assessment.assessment_response %>
      <% if response.present? %>
        <div class="flex flex-wrap gap-2 pt-2">
          <% if @assessment.draft? && policy(response).update? %>
            <%= link_to "Continue assessment",
              edit_space_child_profile_assessment_assessment_response_path(@space, @child_profile, @assessment),
              class: "btn btn-primary" %>
          <% elsif @assessment.submitted? %>
            <%= link_to "View responses",
              space_child_profile_assessment_assessment_response_path(@space, @child_profile, @assessment),
              class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex justify-between mt-6">
    <%= link_to "Back to assessments", space_child_profile_assessments_path(@space, @child_profile), class: "btn btn-ghost" %>
    <% if policy(@assessment).destroy? %>
      <%= button_to "Archive assessment",
        space_child_profile_assessment_path(@space, @child_profile, @assessment),
        method: :delete,
        form: { data: { turbo_confirm: "Archive this assessment? You can keep a record elsewhere if needed." } },
        class: "btn btn-error btn-outline" %>
    <% end %>
  </div>
</div>
