<% template = @assessment_template %>
<% answers = @answers.stringify_keys %>
<% sections = assessment_sections(template) %>
<% progress = assessment_progress(template, answers) %>

<% set_meta_tags(
  title: "Onboarding questions",
  description: "Answer a few questions to build your child's first support profile."
) %>

<section class="mx-auto max-w-5xl px-4 py-12">
  <div class="mb-8 space-y-3">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
      Step 2 of 4
    </p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      Answer a few questions to build a clearer picture.
    </h1>
    <p class="max-w-3xl text-base text-base-content/70">
      We’ll use this as the starting point for your child’s first support profile.
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.7fr)_20rem]">
    <div class="space-y-6">
      <div class="card border border-base-200 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-primary badge-outline">Onboarding assessment</span>
            <span class="badge badge-ghost">For <%= @onboarding_session.child_name.presence || "your child" %></span>
          </div>
          <div class="space-y-2">
            <h2 class="text-2xl font-semibold text-base-content">
              <%= assessment_intro_title(template) %>
            </h2>
            <p class="max-w-3xl text-base leading-7 text-base-content/75">
              <%= assessment_intro_body(template) %>
            </p>
          </div>
        </div>
      </div>

      <%= form_with url: onboarding_assessment_path, method: :patch, scope: :onboarding_assessment, class: "space-y-6" do |form| %>
        <% if @onboarding_session.errors.any? %>
          <div class="alert alert-error">
            <ul class="list-disc list-inside">
              <% @onboarding_session.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="card border border-base-200 bg-base-100 shadow-sm">
          <div class="card-body gap-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="space-y-1">
                <h3 class="text-lg font-semibold text-base-content">Who is answering today?</h3>
                <p class="text-sm text-base-content/70">
                  This helps us interpret the answers with the right context.
                </p>
              </div>
              <div class="min-w-64 flex-1 lg:max-w-sm">
                <fieldset class="fieldset">
                  <label class="label" for="onboarding_assessment_respondent_kind">Respondent</label>
                  <%= form.select :respondent_kind,
                    Array(template.respondent_types).map { |kind| [respondent_kind_label(kind), kind] },
                    { selected: @onboarding_session.respondent_kind },
                    class: "select w-full",
                    id: "onboarding_assessment_respondent_kind" %>
                </fieldset>
              </div>
            </div>
          </div>
        </div>

        <% sections.each_with_index do |section, index| %>
          <% section_progress = assessment_section_progress(section, answers) %>
          <section id="<%= section["id"] %>" class="card border border-base-200 bg-base-100 shadow-sm">
            <div class="card-body gap-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="badge badge-ghost">Section <%= index + 1 %> of <%= sections.size %></span>
                    <span class="badge badge-outline">
                      <%= section_progress[:answered] %>/<%= section_progress[:total] %> answered
                    </span>
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold text-base-content"><%= section["title"] %></h3>
                    <% if section["description"].present? %>
                      <p class="mt-1 text-sm leading-6 text-base-content/70"><%= section["description"] %></p>
                    <% end %>
                  </div>
                </div>
              </div>

              <div class="space-y-4">
                <% Array(section["questions"]).each do |question| %>
                  <%= render "question_field", question: question, answers: answers %>
                <% end %>
              </div>
            </div>
          </section>
        <% end %>

        <div class="flex flex-wrap gap-2">
          <%= button_tag "Save draft", type: "submit", name: "submit_action", value: "draft", class: "btn btn-ghost" %>
          <%= button_tag "Continue to save your profile", type: "submit", name: "submit_action", value: "continue", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
      <div class="card border border-base-200 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div>
            <p class="text-sm font-medium text-base-content/60">Progress</p>
            <h3 class="mt-1 text-2xl font-semibold text-base-content">
              <%= progress[:answered] %> of <%= progress[:total] %> answered
            </h3>
          </div>
          <progress class="progress progress-primary w-full" value="<%= progress[:percentage] %>" max="100"></progress>
          <p class="text-sm text-base-content/70">
            <%= progress[:percentage] %>% complete
          </p>
        </div>
      </div>

      <div class="card border border-base-200 bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h3 class="text-base font-semibold text-base-content">What to expect</h3>
          <ul class="space-y-2 text-sm leading-6 text-base-content/70">
            <li>Answer only what feels true today.</li>
            <li>You can save your progress and come back later.</li>
            <li>We’ll ask you to save your child’s profile before showing results.</li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
</section>
