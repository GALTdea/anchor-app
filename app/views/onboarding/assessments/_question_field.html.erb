<% question = question.stringify_keys %>
<% question_id = question["id"].to_s %>
<% answer_id = "onboarding_answer_#{question_id}" %>
<% question_error = Array(local_assigns[:question_errors]).map(&:to_s).include?(question_id) %>

<fieldset class="fieldset rounded-box border border-base-300/70 bg-base-100 p-5">
  <legend class="fieldset-legend text-base font-semibold text-base-content">
    <%= question["label"] %>
  </legend>

  <% if question["help_text"].present? %>
    <div class="mb-3 text-sm text-base-content/70">
      <%= question["help_text"] %>
    </div>
  <% end %>

  <% case question["type"].to_s %>
  <% when "scale" %>
    <label class="label" for="<%= answer_id %>">
      Rate from <%= question["min"] %> to <%= question["max"] %>
    </label>
    <%= number_field_tag "onboarding_assessment[answers][#{question_id}]",
      answers[question_id],
      id: answer_id,
      min: question["min"],
      max: question["max"],
      class: "input w-full max-w-32",
      data: { action: "input->assessment-autosave#queue blur->assessment-autosave#queueImmediate" } %>
  <% when "textarea" %>
    <label class="label" for="<%= answer_id %>">Your notes</label>
    <%= text_area_tag "onboarding_assessment[answers][#{question_id}]",
      answers[question_id],
      id: answer_id,
      rows: 4,
      class: "textarea w-full",
      data: { action: "input->assessment-autosave#queue blur->assessment-autosave#queueImmediate" },
      placeholder: question["placeholder"].presence || "Add any details that would help us understand your child better" %>
  <% when "text" %>
    <label class="label" for="<%= answer_id %>">Your answer</label>
    <%= text_field_tag "onboarding_assessment[answers][#{question_id}]",
      answers[question_id],
      id: answer_id,
      class: "input w-full",
      data: { action: "input->assessment-autosave#queue blur->assessment-autosave#queueImmediate" },
      placeholder: question["placeholder"].presence || "Type your answer" %>
  <% when "select" %>
    <p class="label">Choose the best fit</p>
    <div class="assessment-choice-group <%= 'assessment-choice-group--error' if question_error %>">
      <div class="space-y-2">
        <% assessment_question_options(question).each_with_index do |(label, value), index| %>
          <% option_id = "#{answer_id}_#{index}" %>
          <label for="<%= option_id %>"
                 class="assessment-choice-card">
            <%= radio_button_tag "onboarding_assessment[answers][#{question_id}]",
              value,
              answers[question_id].to_s == value.to_s,
              id: option_id,
              class: "sr-only",
              data: { action: "change->assessment-autosave#queueImmediate blur->assessment-autosave#queueImmediate" } %>
            <span class="block text-sm font-medium leading-6">
              <%= label %>
            </span>
          </label>
        <% end %>
      </div>
      <% if question_error %>
        <p class="assessment-choice-error">Choose an answer to continue.</p>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-error">Unsupported question type: <%= question["type"] %></p>
  <% end %>
</fieldset>
