<% content_for :actions do %>
  <%= link_to "Preview", preview_admin_assessment_template_path(@assessment_template), class: "btn btn-ghost" %>
  <% if @assessment_template.draft_editable? %>
    <%= link_to "Edit draft", edit_admin_assessment_template_path(@assessment_template), class: "btn btn-primary" %>
    <%= button_to "Publish",
      publish_admin_assessment_template_path(@assessment_template),
      method: :post,
      class: "btn btn-secondary",
      form: { data: { turbo_confirm: "Publish this draft? Published templates become read-only." } } %>
  <% elsif @assessment_template.published? %>
    <% unless onboarding_template_selected?(@assessment_template) %>
      <%= button_to "Use for onboarding",
        set_as_onboarding_admin_assessment_template_path(@assessment_template),
        method: :post,
        class: "btn btn-secondary" %>
    <% end %>
    <%= button_to "Create new version",
      new_version_admin_assessment_template_path(@assessment_template),
      method: :post,
      class: "btn btn-primary" %>
  <% end %>
<% end %>

<%= render "shared/page_header",
  title: @assessment_template.title,
  subtitle: "#{@assessment_template.template_key} · Version #{@assessment_template.version}" %>

<div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
  <div class="space-y-6">
    <section class="rounded-box border border-base-300 bg-base-100 p-6">
      <h2 class="text-lg font-semibold text-base-content">Overview</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-base-content/60">Slug</dt>
          <dd class="mt-1 font-medium"><%= @assessment_template.slug %></dd>
        </div>
        <div>
          <dt class="text-sm text-base-content/60">Category</dt>
          <dd class="mt-1 font-medium"><%= @assessment_template.category.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm text-base-content/60">Status</dt>
          <dd class="mt-1 font-medium">
            <%= @assessment_template.status.humanize %>
            <% if onboarding_template_selected?(@assessment_template) %>
              <span class="badge badge-primary badge-outline ml-2">Onboarding assessment</span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-base-content/60">Schema version</dt>
          <dd class="mt-1 font-medium"><%= @assessment_template.schema_version %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-box border border-base-300 bg-base-100 p-6">
      <h2 class="text-lg font-semibold text-base-content">Draft structure</h2>
      <div class="mt-4 stats stats-vertical border border-base-300 bg-base-200 shadow-none sm:stats-horizontal">
        <div class="stat">
          <div class="stat-title">Sections</div>
          <div class="stat-value text-2xl"><%= @assessment_template.section_count %></div>
        </div>
        <div class="stat">
          <div class="stat-title">Questions</div>
          <div class="stat-value text-2xl"><%= @assessment_template.question_count %></div>
        </div>
      </div>
      <p class="mt-4 text-sm text-base-content/70">
        Step 2 will add section and question editing to this screen. For now, this page gives admins a stable draft detail view.
      </p>
    </section>
  </div>

  <aside class="space-y-6">
    <section class="rounded-box border border-base-300 bg-base-100 p-6">
      <h2 class="text-lg font-semibold text-base-content">Respondent types</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <% if @assessment_template.respondent_types.any? %>
          <% @assessment_template.respondent_types.each do |kind| %>
            <span class="badge badge-outline"><%= respondent_kind_label(kind) %></span>
          <% end %>
        <% else %>
          <span class="text-sm text-base-content/60">No respondent types selected yet.</span>
        <% end %>
      </div>
    </section>

    <section class="rounded-box border border-base-300 bg-base-100 p-6">
      <h2 class="text-lg font-semibold text-base-content">Versioning</h2>
      <p class="mt-3 text-sm text-base-content/70">
        Published template versions stay immutable. Create a new draft version when the assessment needs to evolve.
      </p>
    </section>
  </aside>
</div>
