<%= form_with model: [:admin, assessment_template],
  class: "space-y-6",
  data: { controller: "assessment-template-editor" } do |f| %>
  <% if assessment_template.errors.any? %>
    <div class="alert alert-error">
      <span><%= pluralize(assessment_template.errors.count, "error") %> prevented this template from saving.</span>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-5">
      <legend class="fieldset-legend">Template metadata</legend>

      <label class="label" for="assessment_template_title">Title</label>
      <%= f.text_field :title, class: "input w-full", id: "assessment_template_title" %>

      <label class="label" for="assessment_template_slug">Slug</label>
      <%= f.text_field :slug, class: "input w-full", id: "assessment_template_slug" %>

      <label class="label" for="assessment_template_template_key">Template key</label>
      <%= f.text_field :template_key, class: "input w-full", id: "assessment_template_template_key" %>

      <label class="label" for="assessment_template_category">Category</label>
      <%= f.text_field :category, class: "input w-full", id: "assessment_template_category" %>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-5">
      <legend class="fieldset-legend">Draft settings</legend>

      <label class="label" for="assessment_template_version">Version</label>
      <%= f.number_field :version, min: 1, class: "input w-full max-w-32", id: "assessment_template_version" %>

      <label class="label" for="assessment_template_schema_version">Schema version</label>
      <%= number_field_tag "assessment_template[schema_version]",
        assessment_template.schema_version,
        min: 1,
        class: "input w-full max-w-32",
        id: "assessment_template_schema_version" %>

      <div class="mt-4">
        <p class="label">Allowed respondent types</p>
        <div class="mt-2 space-y-2">
          <% AssessmentRespondentKinds::CANONICAL.each do |kind| %>
            <label class="label cursor-pointer justify-start gap-3">
              <%= check_box_tag "assessment_template[respondent_types][]",
                kind,
                assessment_template.respondent_types.map(&:to_s).include?(kind),
                id: "assessment_template_respondent_types_#{kind}",
                class: "checkbox checkbox-sm" %>
              <span><%= respondent_kind_label(kind) %></span>
            </label>
          <% end %>
        </div>
      </div>
    </fieldset>
  </div>

  <section class="space-y-4 rounded-box border border-base-300 bg-base-100 p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold text-base-content">Draft structure</h2>
        <p class="mt-1 text-sm text-base-content/70">
          Build sections and questions here. Use the order fields to control how the assessment appears.
        </p>
      </div>
      <button type="button" class="btn btn-outline btn-sm" data-action="assessment-template-editor#addSection">
        Add section
      </button>
    </div>

    <div class="space-y-4" data-assessment-template-editor-target="sectionList">
      <% schema_editor_sections(assessment_template).each_with_index do |section, section_index| %>
        <%= render "section_fields",
          assessment_template: assessment_template,
          section: section,
          section_index: section_index,
          template_mode: false %>
      <% end %>
    </div>

    <template data-assessment-template-editor-target="sectionTemplate">
      <%= render "section_fields",
        assessment_template: assessment_template,
        section: assessment_template.send(:default_editor_section),
        section_index: "__SECTION_INDEX__",
        template_mode: true %>
    </template>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= f.submit assessment_template.persisted? ? "Save draft" : "Create draft", class: "btn btn-primary" %>
    <%= link_to "Cancel",
      assessment_template.persisted? ? admin_assessment_template_path(assessment_template) : admin_assessment_templates_path,
      class: "btn btn-ghost" %>
  </div>
<% end %>
