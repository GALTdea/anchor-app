<!DOCTYPE html>
<html lang="en" data-theme="starter_light">
  <head>
    <%= display_meta_tags(
  site: "My Rails Starter",
  title: "Dashboard",
  separator: "·"
) %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="min-h-screen bg-base-200">
    <% admin_sidebar = current_user&.admin? && controller_path.start_with?("admin/") %>

    <% if admin_sidebar %>
      <div class="drawer lg:drawer-open">
        <input id="drawer-toggle" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col">
          <%= render "shared/dashboard_top_nav", drawer: true, show_primary_navigation: false %>

          <main class="flex-1 p-4 lg:p-6">
            <div id="flash">
              <%= render "shared/flash" %>
            </div>
            <%= yield %>
          </main>
        </div>

        <%= render "shared/dashboard_sidebar" %>
      </div>
    <% else %>
      <div class="min-h-screen flex flex-col">
        <%= render "shared/dashboard_top_nav", drawer: false, show_primary_navigation: true %>

        <main class="flex-1 p-4 lg:p-6">
          <div id="flash">
            <%= render "shared/flash" %>
          </div>
          <%= yield %>
        </main>
      </div>
    <% end %>
  </body>
</html>
